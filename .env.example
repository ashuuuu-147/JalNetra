# ==============================================================================
# JalNetra (FloodGuard AI) — SIH 2026 PS 26192 Environment Configuration
# ==============================================================================
# IMPORTANT: Never commit real API keys, tokens, passwords, or cookies to Git.
# Copy this file to .env and populate authorized credentials where available.
# When a credential is omitted, the corresponding adapter explicitly reports
# "authentication_required" rather than fabricating data.

# --- Application & Database ---
APP_NAME="JalNetra (FloodGuard AI)"
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# PostgreSQL + PostGIS connection URL (falls back to sqlite:///./data/jalnetra.db for zero-Docker local runs)
DATABASE_URL=sqlite:///./data/jalnetra.db
POSTGIS_DATABASE_URL=postgresql+psycopg2://jalnetra:jalnetra_dev_only@localhost:5432/jalnetra

# --- Official & Research Data Source Credentials (Authorized Access Only) ---
# 1. India Meteorological Department (IMD) API (https://api.imd.gov.in/public/api_reference.html)
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in

# 2. IMD National Flash Flood Guidance (https://hydro.imd.gov.in/national/)
IMD_FFG_AUTH_TOKEN=

# 3. ISRO / MOSDAC GSMaP_ISRO Rain (https://mosdac.gov.in/gsmap-isro-rain)
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# 4. NASA GPM IMERG / Earthdata (https://gpm.nasa.gov/data/imerg)
NASA_EARTHDATA_TOKEN=

# 5. Copernicus Climate Data Store — ERA5-Land (https://cds.climate.copernicus.eu/)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
# Open-Meteo ERA5-Land / Forecast / Elevation public mirror (CC-BY 4.0, no auth required)
ERA5_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# 6. Central Water Commission (CWC) / India-WRIS (https://cwc.gov.in/hydro-meteorological-observation)
CWC_API_KEY=
CWC_BASE_URL=https://ffs.india-water.gov.in

# 7. NRSC / ISRO National Database for Emergency Management (https://ndem.nrsc.gov.in/)
NDEM_ACCESS_TOKEN=

# 8. OpenStreetMap Overpass API (ODbL, open access with polite User-Agent)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=JalNetra-FloodGuardAI-SIH2026/1.0

# --- IoT ESP32 Sensor Gateway (MQTT + HTTP Fallback) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=jalnetra/sensors
MQTT_USERNAME=
MQTT_PASSWORD=
IOT_INGEST_SHARED_SECRET=
